<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_candle" model="ir.ui.view">
        <field name="name">product.template.form.candle</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="candle_information" string="Candle Information">
                    <group>
                        <group>
                            <field name="candle_wick_type"/>
                            <field name="candle_burn_time"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
